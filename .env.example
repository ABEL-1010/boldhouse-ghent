# Copy to .env at the repo root: cp .env.example .env
# Both backend (pydantic-settings) and frontend (next.config.ts) read this one file.

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=

# Fill in the current model IDs from the Anthropic docs:
# https://docs.anthropic.com/en/docs/about-claude/models
# AGENT_MODEL: a capable Opus/Sonnet-class model that runs the agent loop.
# JUDGE_MODEL: a fast Haiku-class model that explains flagged actions.
AGENT_MODEL=
JUDGE_MODEL=
# Safety stop: maximum model turns per agent run.
AGENT_MAX_TURNS=15

# --- Sentinel API ----------------------------------------------------------
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
# Local fake web server used for the prompt-injection demo.
FAKE_WEB_PORT=8001
# Seconds a paused action waits for a human before the fail-safe deny (must be < 120).
DECISION_TIMEOUT_SECONDS=90
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# Inlined into the browser bundle at build time; restart `npm run dev` after changing.
NEXT_PUBLIC_API_URL=http://localhost:8000
